local trapsEspEnabled = false
local xrayEnabled = false 
local originalTransparency = {}
local enemyOutlineColor = Color3.fromRGB(255, 30, 80)
local allyOutlineColor = Color3.fromRGB(0, 255, 128)
local innocentColor = Color3.fromRGB(0, 170, 255)
local gunEspColor = Color3.fromRGB(255, 215, 0)
local trapEspColor = Color3.fromRGB(255, 100, 0)
local visualsTab = Window:Tab({ Title = "Visuals", Icon = "eye", ShowTabTitle = true, Border = true })

visualsTab:Divider()
visualsTab:Paragraph({ Title = "Role ESP System", Desc = "" })

local function updateMM2ESP()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local root = plr.Character.HumanoidRootPart
            local hlName = plr.Name .. "_MM2ESP"
            local existingHl = ProtectedGui:FindFirstChild(hlName)
            
            if espEnabled then
                local isLocal = (plr == LocalPlayer)
                if isLocal and not espSelf then
                    if existingHl then existingHl:Destroy() end
                else
                    local role = getRole(plr)
                    local shouldShow = (role == "Murderer" and espMurderer) or (role == "Sheriff" and espSheriff) or (role == "Innocent" and espInnocent)
                    if shouldShow then
                        if not existingHl then
                            existingHl = Instance.new("Highlight")
                            existingHl.Name = hlName
                            existingHl.Adornee = plr.Character
                            existingHl.FillTransparency = 0.85
                            existingHl.OutlineTransparency = 0
                            existingHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            existingHl.Parent = ProtectedGui
                        end
                        if role == "Murderer" then existingHl.OutlineColor = enemyOutlineColor; existingHl.FillColor = enemyOutlineColor
                        elseif role == "Sheriff" then existingHl.OutlineColor = allyOutlineColor; existingHl.FillColor = allyOutlineColor
                        else existingHl.OutlineColor = innocentColor; existingHl.FillColor = innocentColor end
                    else
                        if existingHl then existingHl:Destroy() end
                    end
                end
            else
                if existingHl then existingHl:Destroy() end
            end
        end
    end
end

